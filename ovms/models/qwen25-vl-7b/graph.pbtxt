# Canonical OVMS 2026.1.0 LLM/VLM graph (continuous batching).
# device: NPU on Intel Lunar Lake (AI Boost) — the vision tower is convolution-
# heavy and benefits from the NPU's static-shape pipeline, while the LLM decoder
# runs there via NPUW (NPU Wrapper) static-shape compilation.
# Requires:
#   * /dev/accel/accel0 exposed to the container (see docker-compose.linux.yml)
#   * intel-driver-compiler-npu + intel-fw-npu on the host
#   * IRs exported STATEFUL (NPUW handles the StatefulToStateless pass itself)
#
# Falls back to CPU if NPU is unavailable: just change device to "CPU"
# and drop the NPUW_* plugin entries.

input_stream: "HTTP_REQUEST_PAYLOAD:input"
output_stream: "HTTP_RESPONSE_PAYLOAD:output"

node: {
  name: "LLMExecutor"
  calculator: "HttpLLMCalculator"
  input_stream: "LOOPBACK:loopback"
  input_stream: "HTTP_REQUEST_PAYLOAD:input"
  input_side_packet: "LLM_NODE_RESOURCES:llm"
  output_stream: "LOOPBACK:loopback"
  output_stream: "HTTP_RESPONSE_PAYLOAD:output"
  input_stream_info: {
    tag_index: "LOOPBACK:0"
    back_edge: true
  }
  node_options: {
    [type.googleapis.com / mediapipe.LLMCalculatorOptions]: {
      models_path: "./",
      device: "NPU",
      max_num_seqs: 4,
      enable_prefix_caching: false,
      cache_size: 0,
      plugin_config: '{"CACHE_DIR":"/tmp/.ov_cache/qwen25-vl-7b","NPU_USE_NPUW":"YES","NPUW_LLM":"YES","NPUW_LLM_MAX_PROMPT_LEN":"1024","NPUW_LLM_MIN_RESPONSE_LEN":"256"}'
    }
  }
  input_stream_handler {
    input_stream_handler: "SyncSetInputStreamHandler",
    options {
      [mediapipe.SyncSetInputStreamHandlerOptions.ext] {
        sync_set {
          tag_index: "LOOPBACK:0"
        }
      }
    }
  }
}
